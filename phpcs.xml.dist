<?xml version="1.0"?>
<ruleset name="NivoSearch">
	<description>Coding standards for NivoSearch.</description>

	<file>./nivo-ajax-search-for-woocommerce.php</file>
	<file>./uninstall.php</file>
	<file>./includes</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/includes/data/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Start with the security-critical rules; widen to the full WordPress ruleset later. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL">
		<!-- Table names ($wpdb->posts, $wpdb->prefix . ...) and generated %s placeholder lists
		     are interpolated by design; values are still passed through $wpdb->prepare(). -->
		<exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="nivo-ajax-search-for-woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
